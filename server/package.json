{
  "name": "morpheus-ai-server",
  "version": "1.0.0",
  "description": "Server for Morpheus AI",
  "main": "index.js",
  "scripts": {
    "watch": "cross-env NODE_ENV=development webpack --watch --config config/webpack.config.dev.js --progress",
    "debug": "nodemon --inspect dist/server.bundle.js",
    "serve": "cross-env APP_ENV=dev npm-run-all -p watch debug",
    "build": "cross-env NODE_ENV=production webpack --config config/webpack.config.prod.js",
    "build:dev": "cross-env NODE_ENV=production APP_ENV=dev webpack --config config/webpack.config.prod.js",
    "build:test": "cross-env NODE_ENV=production APP_ENV=test webpack --config config/webpack.config.prod.js",
    "build:prod": "cross-env NODE_ENV=production webpack --config config/webpack.config.prod.js",
    "start": "node dist/server.bundle.js"
  },
  "engines": {
    "node": ">=16.20.2"
  },
  "dependencies": {
    "@koa/bodyparser": "^5.1.1",
    "@koa/multer": "^3.0.2",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "alipay-sdk": "^4.14.0",
    "axios": "^1.13.6",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-router": "^12.0.1",
    "koa-static": "^5.0.0",
    "lodash": "^4.17.21",
    "log4js": "^6.9.1",
    "md5": "^2.3.0",
    "minio": "^7.1.3",
    "mongoose": "^8.4.0",
    "mqtt": "^5.10.3",
    "multer": "1.4.3",
    "nodemailer": "^6.9.13",
    "qs": "^6.15.0",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/plugin-transform-optional-chaining": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/koa": "^2.15.0",
    "@types/koa__multer": "^2.0.8",
    "@types/koa-router": "^7.4.8",
    "@types/koa-static": "^4.0.4",
    "@types/lodash": "^4.17.13",
    "@types/log4js": "^2.3.5",
    "@types/md5": "^2.3.5",
    "@types/mongoose": "^5.11.97",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "6.6.0",
    "@typescript-eslint/parser": "6.6.0",
    "babel-loader": "^8.3.0",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^7.0.3",
    "eslint": "7",
    "jest": "^30.3.0",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.2.2",
    "terser-webpack-plugin": "4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^6.2.2",
    "typescript": "^5.4.5",
    "webpack": "4",
    "webpack-cli": "3",
    "webpack-merge": "^5.10.0",
    "webpack-node-externals": "^3.0.0"
  }
}
